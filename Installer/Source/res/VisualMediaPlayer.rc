IDR_BACK_SVG RCDATA "Back_Button.svg"
IDR_IMAGE_SVG RCDATA "Image_Button.svg"
IDR_VIDEOS_SVG RCDATA "Videos_Button.svg"
IDR_NATIVE_SVG RCDATA "Native_Button.svg"
IDR_PREVIOUS_SVG RCDATA "Previous_Button.svg"
IDR_NEXT_SVG RCDATA "Next_Button.svg"
IDR_VOLUME_SVG RCDATA "Volume_Icon.svg"
IDR_VOLUME_MUTE_SVG RCDATA "Volume_Mute_Icon.svg"
IDR_SKIP30_SVG RCDATA "Skip30sec_Button.svg"
IDR_PAUSE_SVG RCDATA "Pause_Button_PopupMenu.svg"
IDR_PLAY_SVG RCDATA "Play_Button_PopupMenu.svg"
IDR_VR_PROJECTION_SVG RCDATA "VRProjection_Button.svg"
