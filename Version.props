<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Single source of truth for product/release versioning. -->
  <PropertyGroup>
    <VmpVersionMajor>12</VmpVersionMajor>
    <VmpVersionMinor>6</VmpVersionMinor>
    <VmpVersionPatch>6</VmpVersionPatch>
    <VmpVersionBuild>0</VmpVersionBuild>
    <VmpVersion>$(VmpVersionMajor).$(VmpVersionMinor).$(VmpVersionPatch)</VmpVersion>
    <VmpVersionFourPart>$(VmpVersion).$(VmpVersionBuild)</VmpVersionFourPart>
  </PropertyGroup>

  <!-- Keep C++/RC constants and both manifests synchronized even for builds
       started directly from Visual Studio rather than the .bat wrappers. -->
  <Target Name="SyncVisualMediaPlayerVersion" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)tools\SyncVersion.ps1&quot; -Root &quot;$(MSBuildThisFileDirectory).&quot;" />
  </Target>
</Project>
